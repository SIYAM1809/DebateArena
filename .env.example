# ─── CLIENT (Next.js) ───────────────────────────────────────────────────
# Required: URL where your Express backend is hosted
NEXT_PUBLIC_API_URL=https://your-backend.railway.app

# Required: URL for Socket.io connection (same as API URL usually)
NEXT_PUBLIC_SOCKET_URL=https://your-backend.railway.app


# ─── SERVER (Node.js + Express) ──────────────────────────────────────────

# Server config
PORT=8080
NODE_ENV=development

# MongoDB Atlas (free M0 cluster)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/debatearena

# Upstash Redis (free tier — get at https://upstash.com)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# JWT secrets — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=your_64_char_random_string_here
JWT_REFRESH_SECRET=your_other_64_char_random_string_here

# Hugging Face (free — get token at https://huggingface.co/settings/tokens)
HUGGING_FACE_TOKEN=hf_xxx

# Cloudinary (free 25GB — get at https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Gmail SMTP (use App Password — enable 2FA first)
EMAIL_USER=youremail@gmail.com
EMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Frontend URL for CORS (Vercel URL after deploying)
CLIENT_URL=https://your-app.vercel.app
